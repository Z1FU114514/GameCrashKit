<Window x:Class="GameCrashKit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GameCrashKit.Core.Models;assembly=GameCrashKit.Core"
        Title="GameCrash Kit（游戏闪退急诊室）v0.1-alpha"
        Width="1220"
        Height="780"
        MinWidth="960"
        MinHeight="620"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Toolbar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="GameCrash Kit" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="游戏闪退急诊室" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,2,16,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="扫描范围：" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox Width="190"
                              ItemsSource="{Binding WindowPresets}"
                              SelectedItem="{Binding SelectedWindowPreset}"
                              DisplayMemberPath="DisplayName"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              AutomationProperties.Name="扫描时间范围" />

                    <CheckBox Content="显示全部应用事件"
                              IsChecked="{Binding IncludeAllApplications}"
                              VerticalAlignment="Center"
                              Margin="0,0,14,0"
                              ToolTip="默认会隐藏常见系统外壳进程崩溃；勾选后展示所有应用事件" />

                    <Button Content="开始只读诊断 (F5)"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartScanCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="取消 (Esc)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelScanCommand}"
                            Margin="0,0,8,0" />

                    <Button Content="手选日志文件 (Ctrl+O)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SelectManualLogButton_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Status & Partial Degradation Banner -->
        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,8"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{StaticResource BorderBrushLight}"
                Background="{StaticResource CardBackgroundBrush}"
                Visibility="{Binding ShowStatusBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding StatusHeadline}" FontWeight="SemiBold" FontSize="13.5" />
                <TextBlock Text="{Binding StatusDetail}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="{Binding PartialWarningText}"
                           Foreground="{StaticResource WarningTextBrush}"
                           Background="{StaticResource WarningBgBrush}"
                           Padding="8,4"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasPartialWarning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!-- 3. Main Two-Column Split Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Incident Candidates + Discovered Engine Logs -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Candidate List Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="近期故障候选（按疑似游戏优先）" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding FilteredNoiseHint}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Candidates}"
                                 SelectedItem="{Binding SelectedCandidate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="近期故障候选列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrushLight}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6"
                                            Background="{StaticResource CardBackgroundBrush}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5" DockPanel.Dock="Left" />
                                                <TextBlock Text="{Binding TimeDisplayText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <WrapPanel Margin="0,4,0,0">
                                                <Border Background="{StaticResource NeutralBadgeBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding AnchorBadgeText}" FontSize="11" Foreground="{StaticResource NeutralBadgeTextBrush}" />
                                                </Border>
                                                <Border Background="{StaticResource NextActionBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,2"
                                                        Visibility="{Binding IsLikelyGame, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="常见游戏目录" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                                </Border>
                                                <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,0,2"
                                                        Visibility="{Binding HasMultipleOccurrences, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding OccurrenceBadgeText}" FontSize="11" Foreground="{StaticResource WarningTextBrush}" />
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding SubtitleText}"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11.5"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Engine Log Discovery & Manual Fallback Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,8,0,0" MaxHeight="250">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="游戏引擎日志（需您确认归属）" FontWeight="SemiBold" FontSize="13.5" DockPanel.Dock="Left" />
                            <Button Content="清除关联"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="8,2"
                                    FontSize="11.5"
                                    Command="{Binding ClearEngineLogCommand}"
                                    DockPanel.Dock="Right" />
                        </DockPanel>

                        <TextBlock Text="{Binding AttachedEngineLogSummary}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EngineLogFeedbackMessage}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,6" />

                        <TextBlock Text="扫描窗内发现的 Unity / Unreal 日志（点击确认关联）："
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,4" />

                        <ListBox ItemsSource="{Binding DiscoveredEngineLogs}"
                                 MaxHeight="105"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button Content="确认关联"
                                                DockPanel.Dock="Right"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,2"
                                                FontSize="11.5"
                                                Command="{Binding DataContext.AttachDiscoveredLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SanitizedLocationHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="提示：也可直接把单个 .log / .txt / .xml 崩溃日志拖入本窗口"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Column: Three-Section Diagnosis Report -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Section 1: Diagnosis Conclusions & Next Actions -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="一、诊断结论与下一步建议" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding ReportHeaderSummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding PrimaryFindings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushLight}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding RuleTag}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                                </DockPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                                                    <Border Background="{StaticResource NeutralBadgeBgBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding AttributionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource NeutralBadgeTextBrush}" />
                                                    </Border>
                                                    <Border CornerRadius="4" Padding="7,2">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource NeutralBadgeBgBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.ExplicitRecord}">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.LimitedClue}">
                                                                        <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding EvidenceStrengthText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Statement}" TextWrapping="Wrap" LineHeight="20" />

                                                <TextBlock Text="{Binding AmbiguityText}"
                                                           Foreground="{StaticResource WarningTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasAmbiguity, Converter={StaticResource BoolToVis}}" />

                                                <Border Background="{StaticResource NextActionBgBrush}" CornerRadius="5" Padding="10,7" Margin="0,8,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="建议下一步：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                                        <TextBlock Text="{Binding NextActionText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="{Binding OfficialReferenceLabel}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,6,0,0"
                                                        Padding="8,3"
                                                        FontSize="11.5"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.OpenReferenceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding OfficialReferenceUrl}"
                                                        Visibility="{Binding HasOfficialReference, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Collapsible Technical Evidence, System Background & Coverage -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Expander IsExpanded="False" Header="二、技术证据定位、系统背景事件与数据源覆盖（点击展开核对）" FontWeight="SemiBold">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="原始证据定位" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding EvidenceItems}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="0,5">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                                        <Run Text="{Binding SourceKindText, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding TimestampText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SourceLocation}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="系统背景时间线（仅系统背景，无具体进程归属，非崩溃根因）" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding SystemBackgroundItems}" Margin="0,0,0,10">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2">
                                                <Run Text="[" />
                                                <Run Text="{Binding TimestampText, Mode=OneWay}" />
                                                <Run Text="] (" />
                                                <Run Text="{Binding AttributionText, Mode=OneWay}" />
                                                <Run Text=") " />
                                                <Run Text="{Binding SummaryText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="数据源采集覆盖范围" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding CoverageItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,2">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text=" — 状态: " />
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                <Run Text=" | 读取条数: " />
                                                <Run Text="{Binding RecordsRead, Mode=OneWay}" />
                                                <Run Text=" | " />
                                                <Run Text="{Binding DetailText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Section 3: 7 Neutral Environment Facts -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="三、本机环境事实快照（中性参考，非崩溃归因）" FontSize="14.5" FontWeight="Bold" DockPanel.Dock="Left" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource NeutralBadgeBgBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NoticeLevel}" Value="{x:Static models:EnvironmentNoticeLevel.Attention}">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding NoticeBadgeText}" FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ValueText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 4. Footer Status Strip -->
        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   FontSize="11.5"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="v0.1-alpha · 纯本地只读 · 零提权 (asInvoker) · 反作弊零接触 · 零网络请求 · 关闭窗口即释放全部内存数据（PNG/Markdown 急诊单导出将在 M3 阶段交付）" />
    </Grid>
</Window>
