<Window x:Class="GameCrashKit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:GameCrashKit.Core.Models;assembly=GameCrashKit.Core"
        Title="{Binding WindowTitle, FallbackValue='GameCrash Kit（游戏闪退急诊室）'}"
        Width="1240"
        Height="800"
        MinWidth="860"
        MinHeight="480"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/GameCrashKit.App;component/Assets/app.ico"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        WindowStartupLocation="CenterScreen">

    <Border Background="{StaticResource AppBackgroundBrush}" Padding="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Hero Header Bar (暗影石板 + 电光靛蓝->赛博青 2px 顶光条) -->
        <Border Grid.Row="0"
                Background="{StaticResource HeroHeaderBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,0,0,8"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel>
                <Border Height="2"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource BrandGradientBrush}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shield + Pulse Vector Badge -->
                        <Border Background="#161D33"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="38"
                                Height="38"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <Path Data="M 10,2 L 18,5 V 11 C 18,15.5 14.5,18.5 10,20 C 5.5,18.5 2,15.5 2,11 V 5 Z M 5.5,11 H 8 L 9.5,8 L 11,13.5 L 12.5,11 H 14.5"
                                  Stroke="{StaticResource BrandCyanBrush}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GameCrash Kit"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <Border Background="{StaticResource InfoBgBrush}"
                                        BorderBrush="#1E3A5F"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="7,2"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="游戏闪退急诊室"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandCyanBrush}" />
                                </Border>
                                <Border Background="{StaticResource InteractiveSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersionDisplay, FallbackValue='v0.1.0-alpha.1'}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="纯本地只读事后取证 · 零提权 · 不接触游戏进程"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                               Orientation="Horizontal"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="12,0,0,0">
                        <Button Content="开始只读诊断 (F5)"
                                Style="{StaticResource HeaderPrimaryButtonStyle}"
                                Command="{Binding StartScanCommand}"
                                Margin="0,2,8,2" />
                        <Button Content="取消 (Esc)"
                                Style="{StaticResource HeaderGhostButtonStyle}"
                                Command="{Binding CancelScanCommand}"
                                Margin="0,2,8,2" />
                        <Button Content="预览与导出急诊单 (Ctrl+E)"
                                Style="{StaticResource HeaderGhostButtonStyle}"
                                IsEnabled="{Binding HasReport}"
                                Click="OpenSharePreviewButton_Click"
                                Margin="0,2,0,2" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. Responsive Sub-Toolbar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Padding="14,9"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,16,3">
                        <TextBlock Text="扫描时间窗："
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,6,0" />
                        <ComboBox Width="185"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding WindowPresets}"
                                  SelectedItem="{Binding SelectedWindowPreset}"
                                  DisplayMemberPath="DisplayName"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="扫描时间范围" />
                    </StackPanel>

                    <CheckBox Content="显示全部应用事件（含系统外壳进程）"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              IsChecked="{Binding IncludeAllApplications}"
                              VerticalAlignment="Center"
                              Margin="0,3,16,3"
                              ToolTip="默认会隐藏常见系统外壳进程崩溃；勾选后展示所有应用事件" />

                    <Button Content="手选日志文件 (Ctrl+O)"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SelectManualLogButton_Click"
                            Margin="0,3,0,3" />
                </WrapPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource InteractiveSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="9,4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="支持直接拖入 .log / .txt / .xml / .runtime-xml"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- 3. Status & Partial Degradation Banner -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="14,10"
                Margin="0,0,0,10"
                Visibility="{Binding ShowStatusBanner, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="{StaticResource BrandCyanBrush}"
                            VerticalAlignment="Center"
                            Margin="0,0,9,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusHeadline}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Bold"
                               FontSize="13.5"
                               VerticalAlignment="Center" />
                </Grid>

                <ProgressBar IsIndeterminate="True"
                             Height="3"
                             Margin="0,8,0,3"
                             Foreground="{StaticResource BrandCyanBrush}"
                             Background="{StaticResource InteractiveSurfaceBrush}"
                             BorderThickness="0"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="{Binding StatusDetail}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="17,4,0,0" />

                <Border Background="{StaticResource WarningBgBrush}"
                        BorderBrush="{StaticResource WarningBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,6"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasPartialWarning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PartialWarningText}"
                               Foreground="{StaticResource WarningTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Main Two-Column Workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="345" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Incident Candidates + Engine Logs -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Candidate List Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="近期故障候选" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="疑似游戏目录自动置顶" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource InteractiveSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="7,3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    Visibility="{Binding HasFilteredNoiseHint, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FilteredNoiseHint}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Candidates}"
                                 SelectedItem="{Binding SelectedCandidate}"
                                 ItemContainerStyle="{StaticResource CandidateListBoxItemStyle}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="近期故障候选列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayTitle}"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="13.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding TimeDisplayText}"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="11.5"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Background="#20283D" CornerRadius="4" Padding="6,2" Margin="0,0,6,2">
                                                <TextBlock Text="{Binding AnchorBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource InfoBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,2"
                                                    Visibility="{Binding IsLikelyGame, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="常见游戏目录" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandCyanBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource WarningBgBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,0,2"
                                                    Visibility="{Binding HasMultipleOccurrences, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding OccurrenceBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningTextBrush}" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding SubtitleText}"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="11.5"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty Candidate Placeholder -->
                        <Border Grid.Row="1"
                                Background="{StaticResource InteractiveSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowNoCandidatesEmptyState, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="暂无待选故障事件"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="点击上方「开始只读诊断 (F5)」采集近期闪退或卡死事件；也可随时拖入单个 .log / .txt / .xml / .runtime-xml 生成仅日志诊断卡。"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Engine Log Confirmation Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,10,0,0" MaxHeight="260">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="应用 / 引擎日志（可独立诊断）" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="支持冷启动直接诊断或关联到左侧当前事故" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="独立查看"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding ViewStandaloneLogCommand}"
                                        Visibility="{Binding CanSwitchLogViewMode, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,6,0" />
                                <Button Content="关联当前事故"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,3"
                                        FontSize="11"
                                        Command="{Binding BindStandaloneLogToSelectedCandidateCommand}"
                                        Visibility="{Binding CanSwitchLogViewMode, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,6,0" />
                                <Button Content="清除"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="9,3"
                                        FontSize="11.5"
                                        Command="{Binding ClearEngineLogCommand}"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource InteractiveSurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,6">
                            <TextBlock Text="{Binding AttachedEngineLogSummary}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="{Binding EngineLogFeedbackMessage}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandCyanBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasEngineLogFeedback, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasDiscoveredEngineLogs, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="本时间窗内发现的 Unity / Unreal 日志："
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,5" />

                            <ListBox ItemsSource="{Binding DiscoveredEngineLogs}"
                                     MaxHeight="105"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SanitizedLocationHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="确认关联"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="9,3"
                                                    FontSize="11.5"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.AttachDiscoveredLogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right Column: Three-Section Aligned Report -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Section 1: Diagnosis Conclusions & Next Actions -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SectionBadgeStyle}">
                                        <TextBlock Text="1" Style="{StaticResource SectionBadgeTextStyle}" />
                                    </Border>
                                    <TextBlock Text="诊断结论与下一步建议"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource InteractiveSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="9,4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReportHeaderSummary}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <!-- Idle Onboarding Guide -->
                            <Border Background="{StaticResource InteractiveSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Visibility="{Binding ShowIdleWelcome, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="闪退发生后 30 秒急诊流程" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="7" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="① 一键只读取证" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,5" />
                                                <TextBlock Text="点击左上「开始只读诊断 (F5)」，自动提取事件 XML、系统背景与 7 项环境基线。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="7" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="② 确认事故与日志" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,5" />
                                                <TextBlock Text="核对左侧故障程序与时间点；如为 Unity/Unreal 游戏可确认关联日志提升线索精度。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="7" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="③ 导出脱敏急诊单" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,5" />
                                                <TextBlock Text="预览并复制脱敏 Markdown 或保存 96-DPI 高清 PNG 长图，安全发往社区或 AI 排查。" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Findings Cards -->
                            <ItemsControl ItemsSource="{Binding PrimaryFindings}"
                                          Visibility="{Binding HasFindings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushLight}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Margin="0,0,0,10"
                                                Background="{StaticResource InteractiveSurfaceBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="8,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.ExplicitRecord}">
                                                                    <Setter Property="Background" Value="{StaticResource SuccessAccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.LimitedClue}">
                                                                    <Setter Property="Background" Value="{StaticResource WarningAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   FontSize="14.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1"
                                                                Background="{StaticResource CardBackgroundBrush}"
                                                                BorderBrush="{StaticResource BorderBrushLight}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RuleTag}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                                        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding AttributionText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <Border CornerRadius="5" Padding="8,3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.ExplicitRecord}">
                                                                            <Setter Property="Background" Value="{StaticResource SuccessBgBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.LimitedClue}">
                                                                            <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Text="{Binding EvidenceStrengthText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.ExplicitRecord}">
                                                                                <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding EvidenceStrength}" Value="{x:Static models:EvidenceStrength.LimitedClue}">
                                                                                <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Statement}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="21" />

                                                    <TextBlock Text="{Binding AmbiguityText}"
                                                               Foreground="{StaticResource WarningTextBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"
                                                               Visibility="{Binding HasAmbiguity, Converter={StaticResource BoolToVis}}" />

                                                    <Border Background="{StaticResource NextActionBgBrush}"
                                                            BorderBrush="{StaticResource NextActionBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="11,8"
                                                            Margin="0,10,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="建议下一步：" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" />
                                                            <TextBlock Text="{Binding NextActionText}" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Border>

                                                    <Button Content="{Binding OfficialReferenceLabel}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,8,0,0"
                                                            Padding="10,4"
                                                            FontSize="11.5"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.OpenReferenceUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding OfficialReferenceUrl}"
                                                            Visibility="{Binding HasOfficialReference, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section 2: Flush-Left Aligned Collapsible Technical Evidence -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                        <Expander IsExpanded="False" Style="{StaticResource ModernExpanderStyle}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SectionBadgeStyle}">
                                        <TextBlock Text="2" Style="{StaticResource SectionBadgeTextStyle}" />
                                    </Border>
                                    <TextBlock Text="技术证据定位、系统背景事件与数据源覆盖"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="原始证据定位" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="暂无证据记录（请先运行扫描）。"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,10"
                                           Visibility="{Binding ShowIdleWelcome, Converter={StaticResource BoolToVis}}" />

                                <ItemsControl ItemsSource="{Binding EvidenceItems}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                                        <Run Text="{Binding SourceKindText, Mode=OneWay}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding TimestampText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding SourceLocation}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="系统背景时间线（仅系统背景，无具体进程归属，非崩溃根因）" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SystemBackgroundItems}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2">
                                                <Run Text="[" />
                                                <Run Text="{Binding TimestampText, Mode=OneWay}" />
                                                <Run Text="] (" />
                                                <Run Text="{Binding AttributionText, Mode=OneWay}" />
                                                <Run Text=") " />
                                                <Run Text="{Binding SummaryText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="数据源采集覆盖范围" FontWeight="Bold" Foreground="{StaticResource BrandCyanBrush}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding CoverageItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2">
                                                <Run Text="{Binding SourceName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <Run Text=" — 状态: " />
                                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                                <Run Text=" | 读取条数: " />
                                                <Run Text="{Binding RecordsRead, Mode=OneWay}" />
                                                <Run Text=" | " />
                                                <Run Text="{Binding DetailText, Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- Section 3: 7 Neutral Environment Facts -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SectionBadgeStyle}">
                                        <TextBlock Text="3" Style="{StaticResource SectionBadgeTextStyle}" />
                                    </Border>
                                    <TextBlock Text="本机环境事实快照"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{StaticResource InteractiveSurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="9,4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="中性参考 · 非崩溃归因"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <Border Background="{StaticResource InteractiveSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="12"
                                    Visibility="{Binding ShowIdleWelcome, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="扫描后将自动在此展示显卡发布日期、目标路径特征、OneDrive 文档同步、VC++ 运行库、页面文件、覆盖层快照与系统区域 7 项只读环境事实。"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ItemsControl ItemsSource="{Binding EnvironmentItems}"
                                          Visibility="{Binding HasEnvironmentFacts, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding ValueText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Border Grid.Column="1"
                                                        CornerRadius="5"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center"
                                                        Margin="10,0,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource InteractiveSurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NoticeLevel}" Value="{x:Static models:EnvironmentNoticeLevel.Attention}">
                                                                    <Setter Property="Background" Value="{StaticResource WarningBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding NoticeBadgeText}" FontSize="11.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource BrandCyanBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NoticeLevel}" Value="{x:Static models:EnvironmentNoticeLevel.Attention}">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding NoticeLevel}" Value="{x:Static models:EnvironmentNoticeLevel.Unavailable}">
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 5. Clean Footer Status Strip -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="纯本地只读 · 零提权 (asInvoker) · 反作弊零接触 · 零网络请求 · 关闭窗口即释放内存"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1"
                       FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="12,0,0,0"
                       Text="快捷键：F5 扫描 | Esc 取消 | Ctrl+O 选日志 | Ctrl+E 导出" />
        </Grid>
    </Grid>
    </Border>
</Window>
