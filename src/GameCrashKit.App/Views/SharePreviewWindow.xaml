<Window x:Class="GameCrashKit.App.Views.SharePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="脱敏急诊单预览与导出（所见即所得）"
        Width="1000"
        Height="780"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Privacy Controls Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="隐私脱敏控制（默认严格字段白名单，无原始日志/绝对路径/ID）" FontWeight="Bold" FontSize="13.5" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding PrivacyStatusText}" FontSize="12" Foreground="{StaticResource SuccessTextBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                </DockPanel>

                <WrapPanel>
                    <CheckBox Content="隐藏程序名称（替换为 &lt;APP&gt;）"
                              IsChecked="{Binding HideAppName}"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center" />
                    <CheckBox Content="隐藏精确时间戳（仅保留日期与相对时间）"
                              IsChecked="{Binding HideExactTimestamp}"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center" />
                    <CheckBox Content="附带受限脱敏报错摘要（≤5 行 / ≤600 字，仅引擎日志可用）"
                              IsChecked="{Binding IncludeScrubbedErrorExcerpt}"
                              IsEnabled="{Binding CanIncludeExcerpt}"
                              VerticalAlignment="Center" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- WYSIWYG Preview Tabs -->
        <TabControl Grid.Row="1">
            <TabItem Header="PNG 急诊单长图预览（所见即所得）">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding PngDimensionsText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="重试渲染"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RetryPngRenderCommand}"
                                    Visibility="{Binding HasPngRenderError, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,8,0" />
                            <Button Content="保存 PNG 急诊单..."
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding HasValidPng}"
                                    Click="SavePngButton_Click" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1" Background="#E9EDF2" CornerRadius="6">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12">
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top" />
                            </ScrollViewer>

                            <Border Background="{StaticResource WarningBgBrush}"
                                    Padding="16"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    CornerRadius="6"
                                    Visibility="{Binding HasPngRenderError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PngRenderErrorMessage}"
                                           Foreground="{StaticResource WarningTextBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="脱敏 Markdown 预览（与剪贴板逐字一致）">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="可直接粘贴至任意网页 AI 或论坛文字帖" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="保存为 .md..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="SaveMarkdownButton_Click"
                                    Margin="0,0,8,0" />
                            <Button Content="复制 Markdown 到剪贴板"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding CopyMarkdownCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding MarkdownText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12.5"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             Padding="10" />
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Feedback Bar -->
        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="{Binding ActionFeedbackText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button Content="关闭 (Esc)" Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click" DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
