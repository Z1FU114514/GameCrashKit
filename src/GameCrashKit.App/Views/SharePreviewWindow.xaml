<Window x:Class="GameCrashKit.App.Views.SharePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="脱敏急诊单预览与导出（所见即所得）"
        Width="1020"
        Height="790"
        MinWidth="820"
        MinHeight="580"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Icon="pack://application:,,,/GameCrashKit.App;component/Assets/app.ico"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource AppBackgroundBrush}" Padding="14">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hero Privacy Header -->
        <Border Grid.Row="0"
                Background="{StaticResource HeroHeaderBrush}"
                BorderBrush="{StaticResource BorderBrushLight}"
                BorderThickness="1"
                CornerRadius="10"
                Margin="0,0,0,8"
                Effect="{StaticResource CardShadowEffect}">
            <StackPanel>
                <Border Height="2"
                        CornerRadius="10,10,0,0"
                        Background="{StaticResource BrandGradientBrush}" />

                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="脱敏急诊单预览与导出（所见即所得）"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="PNG 与 Markdown 共用同一份不可变白名单投影，导出文件与预览完全一致"
                                   FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="{StaticResource SuccessBgBrush}"
                            CornerRadius="5"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PrivacyStatusText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessTextBrush}" />
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Responsive Privacy Checkboxes -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="隐藏程序名称（替换为 &lt;APP&gt;）"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          IsChecked="{Binding HideAppName}"
                          Margin="0,3,20,3" />
                <CheckBox Content="隐藏精确时间戳（仅保留日期与相对时间）"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          IsChecked="{Binding HideExactTimestamp}"
                          Margin="0,3,20,3" />
                <CheckBox Content="附带受限脱敏报错摘要（≤5 行 / ≤600 字，仅引擎日志可用）"
                          Style="{StaticResource ModernCheckBoxStyle}"
                          IsChecked="{Binding IncludeScrubbedErrorExcerpt}"
                          IsEnabled="{Binding CanIncludeExcerpt}"
                          Margin="0,3,0,3" />
            </WrapPanel>
        </Border>

        <!-- WYSIWYG Preview Tabs -->
        <TabControl Grid.Row="2" Style="{StaticResource ModernTabControlStyle}">
            <TabItem Header="PNG 急诊单长图预览（所见即所得）" Style="{StaticResource ModernTabItemStyle}">
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="0,8,8,8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PngDimensionsText}"
                                       FontSize="12"
                                       Foreground="{StaticResource BrandCyanBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Content="重试渲染"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding RetryPngRenderCommand}"
                                        Visibility="{Binding HasPngRenderError, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,8,0" />
                                <Button Content="保存 PNG 急诊单..."
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        IsEnabled="{Binding HasValidPng}"
                                        Click="SavePngButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                BorderBrush="{StaticResource BorderBrushLight}"
                                BorderThickness="1"
                                Background="{StaticResource AppBackgroundBrush}"
                                CornerRadius="8">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="14">
                                    <Image Source="{Binding PreviewImage}"
                                           Stretch="None"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top" />
                                </ScrollViewer>

                                <Border Background="{StaticResource WarningBgBrush}"
                                        BorderBrush="{StaticResource WarningBorderBrush}"
                                        BorderThickness="1"
                                        Padding="16"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        CornerRadius="6"
                                        Visibility="{Binding HasPngRenderError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PngRenderErrorMessage}"
                                               Foreground="{StaticResource WarningTextBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="脱敏 Markdown 预览（与剪贴板逐字一致）" Style="{StaticResource ModernTabItemStyle}">
                <Border Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushLight}"
                        BorderThickness="1"
                        CornerRadius="0,8,8,8"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="可直接粘贴至任意网页 AI 或论坛文字帖"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <Button Content="保存为 .md..."
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="SaveMarkdownButton_Click"
                                        Margin="0,0,8,0" />
                                <Button Content="复制 Markdown 到剪贴板"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding CopyMarkdownCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 Text="{Binding MarkdownText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 FontSize="12.5"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource InteractiveSurfaceBrush}"
                                 BorderBrush="{StaticResource BorderBrushLight}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 AcceptsReturn="True"
                                 Padding="12" />
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Bottom Feedback Bar -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding ActionFeedbackText}"
                       Foreground="{StaticResource BrandCyanBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1"
                    Content="关闭 (Esc)"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="CloseButton_Click"
                    Margin="12,0,0,0" />
        </Grid>
    </Grid>
    </Border>
</Window>
