<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GameCrashKit.App</RootNamespace>
    <AssemblyName>GameCrashKit.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameCrashKit.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameCrashKit.Core\GameCrashKit.Core.csproj" />
    <ProjectReference Include="..\GameCrashKit.Windows\GameCrashKit.Windows.csproj" />
  </ItemGroup>
</Project>
